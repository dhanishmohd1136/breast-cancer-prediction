# Controls what `gcloud run deploy --source .` uploads to Cloud Build.
# Without this, gcloud would upload myenv/ (738 MB) and node_modules/ (70 MB).
.git/
.gitignore

# Python virtualenvs
myenv/
venv/
.venv/
__pycache__/
*.py[cod]

# Node
frontend/node_modules/
frontend/dist/
*.tsbuildinfo

# Not needed to build the image
notebooks/
.ipynb_checkpoints/

# Local compose files (Cloud Run uses the root Dockerfile)
docker-compose.yml

# Secrets
.env
.env.*
